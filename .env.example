# =============================================================================
# API Configuration for Remote LLM Services
# =============================================================================
# Uncomment and set the API keys for the services you want to use

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
# Used for: GPT-3.5, GPT-4, GPT-4 Turbo models
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Configuration
# Get your API key from: https://console.anthropic.com/
# Used for: Claude models (Claude 3, Claude 2, etc.)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google AI API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
# Used for: Gemini models
GOOGLE_API_KEY=your_google_api_key_here

# Azure OpenAI Configuration
# Get your credentials from: https://portal.azure.com/
# Used for: Azure-hosted OpenAI models
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name

# =============================================================================
# Local LLM Server Configuration
# =============================================================================
# Configure these if you're using a local LLM server like LMStudio or Ollama

# LMStudio Configuration
# Default LMStudio local server URL (usually runs on port 1234)
# Used for: Running models locally through LMStudio
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# Ollama Configuration
# Default Ollama local server URL (usually runs on port 11434)
# Used for: Running models locally through Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Generic Local LLM Configuration
# Use this for other local LLM servers
LOCAL_LLM_BASE_URL=http://localhost:8000
LOCAL_LLM_API_KEY=not_required_for_local

# =============================================================================
# Model Selection and Preferences
# =============================================================================
# Specify which model provider and model to use by default

# Primary model provider: openai, anthropic, google, azure, lmstudio, ollama, local
MODEL_PROVIDER=openai

# Default model to use (varies by provider)
# OpenAI: gpt-4, gpt-4-turbo, gpt-3.5-turbo
# Anthropic: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-2.1
# Google: gemini-pro, gemini-pro-vision
# Local: depends on your local setup
DEFAULT_MODEL=gpt-3.5-turbo

# =============================================================================
# Application Settings
# =============================================================================

# Temperature setting for model responses (0.0 to 2.0)
# Lower values = more deterministic, Higher values = more creative
MODEL_TEMPERATURE=0.7

# Maximum tokens for model responses
MAX_TOKENS=2048

# Enable debug mode (true/false)
DEBUG=false

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# Usage Instructions
# =============================================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual API keys and configuration values
# 3. The .env file is git-ignored and will not be committed
# 
# For Remote LLMs (OpenAI, Anthropic, etc.):
#   - Set the appropriate API key(s)
#   - Set MODEL_PROVIDER to your chosen provider
#   - Set DEFAULT_MODEL to a model available from that provider
#
# For Local LLMs (LMStudio, Ollama):
#   - Start your local LLM server
#   - Set the appropriate BASE_URL to match your server
#   - Set MODEL_PROVIDER to 'lmstudio', 'ollama', or 'local'
#   - Set DEFAULT_MODEL to match your loaded model
#
# You can switch between remote and local LLMs by changing MODEL_PROVIDER
# =============================================================================
